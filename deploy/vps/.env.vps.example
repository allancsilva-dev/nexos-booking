POSTGRES_DB=nexos_booking
POSTGRES_USER=nexos_booking
POSTGRES_PASSWORD=change-owner-password
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=change-runtime-password

JWT_SECRET=change-long-random-secret-at-least-32-bytes
JWT_ISSUER=nexos-booking
JWT_AUDIENCE=nexos-api
ACCESS_TOKEN_TTL_SECONDS=900
BODY_LIMIT_BYTES=102400

# TLS / Let's Encrypt (aponte o DNS A de DOMAIN para o IP da VPS antes de emitir)
DOMAIN=booking.nexostech.com.br
LETSENCRYPT_EMAIL=admin@example.com

PUBLIC_CANCEL_BASE_URL=https://booking.nexostech.com.br/cancelar
RESEND_API_KEY=
RESEND_FROM=

BACKUP_RETENTION_DAYS=7
